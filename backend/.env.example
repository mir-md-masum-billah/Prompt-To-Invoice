NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/PromptToInvoice
# MUST be at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# This backend's own public URL (used for uploaded image links)
PUBLIC_API_URL=http://localhost:4000
# Allowed frontend origins, comma separated, no trailing slash
CLIENT_ORIGINS=http://localhost:5173
